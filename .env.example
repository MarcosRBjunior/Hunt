# Copie para .env.local e preencha. Todas são validadas com Zod na inicialização.

# --- Fase 1 ---
# Fonte dos produtos: mock (nível 1) | prisma (nível 2+)
PRODUCT_SOURCE=mock
# Nível do pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Fase 4 (banco) ---
DATABASE_URL=
# Só se usar pooler
DIRECT_URL=

# --- Fase 6 (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SIGNING_SECRET=
