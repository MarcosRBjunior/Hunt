# Copie para .env.local e preencha. Todas são validadas com Zod na inicialização.

# --- Fase 1 ---
# Fonte dos produtos: mock (nível 1) | prisma (nível 2+)
PRODUCT_SOURCE=mock
# Nível do pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Fase 4 (banco) ---
# Obrigatória com PRODUCT_SOURCE=prisma. Esta é a do docker-compose (npm run db:up).
# Railway (produção): use a DATABASE_PUBLIC_URL terminada em ?sslmode=no-verify
# (certificado autoassinado; sem o parâmetro o driver pg conecta sem SSL).
DATABASE_URL=postgresql://hunt:hunt@localhost:5435/hunt
# Só se usar pooler: conexão direta para o CLI do Prisma (migrate).
DIRECT_URL=
# Lida só pelo seed: true cria a demo (produtos, usuários e votos fictícios).
# Em produção fica vazia, e o seed cria só os 5 topics.
SEED_DEMO=true

# --- Fase 6 (Clerk) ---
# Dashboard do Clerk › Configure › API Keys. A pública começa com pk_, a secreta com sk_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# --- Fase 9 (webhook user.deleted) ---
# Clerk › Webhooks › (endpoint) › Signing Secret. Começa com whsec_.
# Localmente o Clerk não alcança o localhost: qualquer whsec_ fictício serve.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Fase 9 (testes E2E) ---
# Opcional: banco dos testes E2E (precisa terminar em _e2e; é zerado a cada execução).
# Sem ela, os testes usam postgresql://hunt:hunt@localhost:5435/hunt_e2e (Docker).
# E2E_DATABASE_URL=
